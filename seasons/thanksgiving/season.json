        [8, 12, 15],
        [3, 7, 10],
        [10, 14, 17]
      ]
    },
    "intro": [
      {
        "speaker": "narrator",
        "text": "The harbor smells of cinnamon and woodsmoke. Harvest Supper has come to town."
      },
      {
        "speaker": "grandma",
        "expression": "happy",
        "text": "Look what I found! My mother's recipe card: pumpkin pie and cranberry tart."
      },
      {
        "speaker": "grandma",
        "text": "Tap the Pumpkin Patch and see what grows. Folks will order harvest treats, and an order of three makes a Feast. They pay half again for a Feast."
      },
      {
        "speaker": "grandma",
        "expression": "happy",
        "text": "And keep the Flour Mill busy. Pecans have a way of turning up this time of year."
      }
    ]
  }
